/dts-v1/;

#include "qcom-msm8960.dtsi"
#include <dt-bindings/input/input.h>

/ {
    model = "Nokia Lumia 920";
    compatible = "nokia,lumia920", "qcom,msm8960";

    memory@90000000 {
        device_type = "memory";

        reg = <0x80800000 0x00400000>,
              <0x81700000 0x027B2000>,
              <0x84239000 0x0037F000>,
              <0x845BC000 0x00004000>,
              <0x84601000 0x047FF000>,
              <0x90000000 0x2E6CC000>,
              <0xBE6D5000 0x00174000>,
              <0xBE8DA000 0x00049000>,
              <0xBE966000 0x00040000>,
              <0xBEA69000 0x00014000>,
              <0xBFACD000 0x00004000>,
              <0xBFDF7000 0x00001000>;
    };

    reserved-memory {
        #address-cells = <1>;
        #size-cells = <1>;
        ranges;

        framebuffer@80400000 {
            reg = <0x80400000 0x003C0000>;
            no-map;
        };
    };
};